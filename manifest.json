{
    "name": "Salem",
    "version": "1.2.3.5",
    "manifest_version": 3,
    "description": "Automatización y gestión centralizada de mantenimientos preventivos y rutinarios de equipos en la plataforma Salem Estaciones.",
    "content_scripts": [
        {
            "matches": [
                "https://helpdesk.rbsas.co/otobo/*",
                "http://172.20.0.80/otobo/*"
            ],
            "js": [
                "/sources/vendor/js/moment.min.js",
                "/sources/vendor/js/jquery-3.6.1.min.js",
                "/sources/vendor/js/sweetalert2@11.js",
                "/sources/vendor/js/papaparse.min.js",
                "/sources/api/salem.js"
            ],
            "css": [
                "sources/client/css/salem.css"
            ]
        }
    ],
    "background": {
        "service_worker": "/sources/api/background.js"
    },
    "icons": {
        "32": "icons/salem_32x32.png",
        "48": "icons/salem_48x48.png",
        "128": "icons/salem_128x128.png",
        "256": "icons/salem_256x256.png"
    },
    "action": {
        "default_icon": {
            "32": "icons/salem_32x32.png",
            "48": "icons/salem_48x48.png",
            "128": "icons/salem_128x128.png",
            "256": "icons/salem_256x256.png"
        }
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "tabs",
        "contextMenus",
        "alarms"
    ],
    "host_permissions": [
        "https://helpdesk.rbsas.co/*",
        "http://172.20.0.80/*",
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*",
        "https://docs.google.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "sources/popup/login/login.html",
                "sources/popup/login/login.css",
                "sources/popup/login/login.js",
                "sources/client/css/salem.css",
                "sources/client/modals/error/error.html",
                "sources/client/modals/error/error.css",
                "sources/client/modals/loading/loading.html",
                "sources/client/modals/loading/loading.css",
                "sources/vendor/js/jquery-3.6.1.min.js",
                "sources/vendor/js/bootstrap.bundle.min.js",
                "sources/vendor/js/crypto-js.min.js",
                "sources/api/salem.js",
                "icons/salem_48x48.png",
                "icons/salem_512x512.png"
            ],
            "matches": [
                "https://helpdesk.rbsas.co/*",
                "http://172.20.0.80/*"
            ]
        }
    ]
}